{
  "name": "메디보카 · 의학용어",
  "short_name": "메디보카",
  "description": "간호학생용 의학용어 암기 앱 · 하루 50장, 약 15분",
  "lang": "ko",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f7f6",
  "theme_color": "#1d5c74",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        { "name": "backup", "accept": ["application/json", ".json", "application/octet-stream", "text/plain"] }
      ]
    }
  }
}
